---
import "../styles/global.css";
import { Providers } from "../components/Providers";
import { Layout } from "../components/Layout";
import { Hero } from "../components/protocol/Hero";
import { CodeHighlighter } from "../components/CodeHighlighter";
import PackageManagerSwitcher from "../components/PackageManagerSwitcher.astro";
import { getNavigation } from "../lib/navigation";
import { t } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  sections?: Array<{ id: string; title: string; tag?: string }>;
  landing?: boolean;
}

const { title, description, sections = [], landing = false } = Astro.props;
const pathname = Astro.url.pathname;
const locale = Astro.currentLocale ?? "en";

const siteName = t("site.name", undefined, locale);
const defaultTitle = t("site.title", undefined, locale);
const pageTitle =
  !title || title === defaultTitle
    ? defaultTitle
    : t("site.titleTemplate", { title, siteName }, locale);

// Fetch navigation from all collections
const { sections: navigation, apiGroups } = await getNavigation();

// Build allSections object with current page sections
// Handle both with and without trailing slash, and empty pathname
const normalizedPathname = pathname || "/";
// Ensure sections are properly serialized
const serializedSections = sections.map((s) => ({
  id: s.id,
  title: s.title,
  ...(s.tag && { tag: s.tag }),
}));

const allSections: Record<
  string,
  Array<{ id: string; title: string; tag?: string }>
> = {
  [normalizedPathname]: serializedSections,
  [normalizedPathname.replace(/\/$/, "") || "/"]: serializedSections,
  "/": serializedSections, // Also include root path for index page
};
---

<!doctype html>
<html
  lang={locale}
  class="h-full"
  data-syntax="vitesse"
  data-inline-syntax="on"
  data-font="system"
  suppressHydrationWarning
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#121212" />
    <title>{pageTitle}</title>

    <script is:inline>
      (function () {
        try {
          if (typeof window === "undefined") return;
          const theme = localStorage.getItem("theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;

          // Apply theme immediately to prevent flash
          if (
            theme === "dark" ||
            (theme === "system" && prefersDark) ||
            (!theme && prefersDark)
          ) {
            document.documentElement.classList.add("dark");
          } else {
            document.documentElement.classList.remove("dark");
          }

          // The rest of the reading settings, applied before first paint for
          // the same reason: a reader who chose a font or a code palette
          // should never watch the default one repaint into it.
          const root = document.documentElement;
          root.setAttribute("data-font", localStorage.getItem("reading-font") || "system");
          root.setAttribute("data-syntax", localStorage.getItem("syntax-theme") || "vitesse");
          root.setAttribute("data-inline-syntax", localStorage.getItem("inline-syntax") || "on");
          root.setAttribute("data-code-wrap", localStorage.getItem("code-wrap") || "off");
          root.setAttribute("data-text-size", localStorage.getItem("text-size") || "default");
          root.setAttribute("data-spacing", localStorage.getItem("text-spacing") || "normal");
          root.setAttribute("data-reading-width", localStorage.getItem("reading-width") || "full");
        } catch (e) {
          // Ignore errors
        }
      })();
    </script>
  </head>
  <body
    class="flex min-h-full bg-background text-foreground antialiased"
    suppressHydrationWarning
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-primary-foreground"
    >
      {t("layout.skipToContent", undefined, locale)}
    </a>
    <Providers client:load>
      <div class="w-full">
        <Hero />
        <Layout
          allSections={allSections}
          navigation={navigation}
          apiGroups={apiGroups}
          initialPathname={normalizedPathname}
          landing={landing}
          client:load
        >
          <slot />
        </Layout>
      </div>
      <PackageManagerSwitcher />
      <CodeHighlighter client:only="react" />
    </Providers>
  </body>
</html>
